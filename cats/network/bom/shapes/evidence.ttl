@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix cats: <https://cats.dynamicalsystemsgroup.com/ns#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .

cats:EvidenceDatasetShape
    a sh:NodeShape ;
    sh:targetClass dcat:Dataset ;
    sh:property [
        sh:path dct:identifier ;
        sh:minCount 1 ;
        sh:message "evidence dataset must cite a lot ni:" ;
    ] .
