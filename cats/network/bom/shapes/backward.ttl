@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix cats: <https://cats.dynamicalsystemsgroup.com/ns#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .

cats:BackwardEvidenceShape
    a sh:NodeShape ;
    sh:targetClass dcat:Dataset ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "lot has no Invoice DCAT conformsTo or allocate inverse" ;
        sh:select """
            PREFIX dcat: <http://www.w3.org/ns/dcat#>
            PREFIX dct: <http://purl.org/dc/terms/>
            PREFIX cats: <https://cats.dynamicalsystemsgroup.com/ns#>
            SELECT $this WHERE {
                ?catalog a dcat:Catalog ;
                    dcat:dataset $this .
                FILTER NOT EXISTS {
                    ?catalog dct:conformsTo ?contract .
                    ?target cats:allocatedFrom ?clause .
                    ?clause cats:allocatesTo ?target .
                }
            }
        """ ;
    ] .
