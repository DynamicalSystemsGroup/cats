@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix cats: <https://cats.dynamicalsystemsgroup.com/ns#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .

cats:ForwardClauseShape
    a sh:NodeShape ;
    sh:targetSubjectsOf cats:allocatesTo ;
    sh:property [
        sh:path cats:allocatesTo ;
        sh:minCount 1 ;
        sh:message "clause must allocate to a Process usage or concern" ;
    ] .

cats:ForwardPromiseShape
    a sh:NodeShape ;
    sh:targetClass dcat:Catalog ;
    sh:property [
        sh:path dct:conformsTo ;
        sh:minCount 1 ;
        sh:message "mBOM did not promise the contract" ;
    ] .
