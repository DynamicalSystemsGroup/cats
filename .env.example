# CATs operator / secrets — copy to `.env` in the repo root (gitignored).
# `cats` loads this file on import (cwd-independent). Shell env wins over `.env`.
# Leave a variable commented to keep the code default. Do not set empty `VAR=`.
#
# Does not belong here: CATS_HOME, TF_DATA_DIR, INTEGRATION_INPUT_DATA_CACHE,
# RAY_ENABLE_UV_RUN_RUNTIME_ENV, WERKZEUG_RUN_MAIN (derived or written by cats).

# --- Node ---
# CAT_NODE_HOST=127.0.0.1
# CAT_NODE_PORT=5000
# CAT_NODE_DID=did:key:z...

# --- Optional Kubo HTTP API ---
# IPFS_API_HOST=127.0.0.1
# IPFS_API_PORT=5001

# --- Process I/O (demo knobs) ---
# CATS_IO_PARTITIONS=1
# CATS_IO_VIA_JOB=0

# --- Solid control plane (unset = Node LDP only; see docs/SOLID.md) ---
# SOLID_POD_BASE_URL=https://pod.example/user/
# SOLID_BOMS_PATH=/boms
# SOLID_CLIENT_ACCESS_TOKEN=
# SOLID_CLIENT_ID=
# SOLID_CLIENT_SECRET=
# SOLID_WEBID=https://pod.example/user/profile/card#me
# SOLID_BOM_READERS=
# SOLID_LDN_INBOX_URLS=

# --- MAC experiment (experiments/mac/MAC.md) ---
# OPENAI_API_KEY=
# LANGCHAIN_API_KEY=
# TAVILY_API_KEY=
